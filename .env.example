# ---------------------------------------------------------------------------
# TorsdagBot – indstillinger
#
# 1. Kopiér denne fil og omdøb kopien til:  .env
# 2. Udfyld værdierne nedenfor.
# 3. Læg .env-filen i SAMME mappe som TorsdagBot.exe (eller som bot.py).
#
# Filen må ALDRIG deles eller uploades til GitHub – den indeholder dit token.
# ---------------------------------------------------------------------------

# === PÅKRÆVET ==============================================================

# Bottens token fra Discord Developer Portal (Bot -> Reset Token -> Copy)
DISCORD_TOKEN=indsæt_token_her

# ID'et på den kanal afstemningen skal sendes i
# (Slå Developer Mode til i Discord -> højreklik på kanalen -> Kopiér kanal-ID)
CHANNEL_ID=indsæt_kanal_id_her

# Dit eget Discord-bruger-ID. Kun denne bruger må køre /testvote
# (højreklik på dig selv -> Kopiér bruger-ID)
OWNER_ID=indsæt_dit_bruger_id_her


# === VALGFRIT ==============================================================
# Alt herunder har fornuftige standardværdier og kan bare stå som det er.

# Serverens ID. Sættes den, bliver /testvote synlig med det samme i stedet for
# at vente op til en time på Discords globale opdatering.
#GUILD_ID=

# Hvornår afstemningen sendes.
# POLL_WEEKDAY: 0 = mandag, 1 = tirsdag, 2 = onsdag, 3 = torsdag ... 6 = søndag
#POLL_WEEKDAY=3
#POLL_HOUR=15
#POLL_MINUTE=0

# Tidszone (håndterer automatisk sommer- og vintertid)
#TIMEZONE=Europe/Copenhagen

# Hvordan afstemningen laves:
#   auto    = Discords indbyggede poll hvis biblioteket understøtter det,
#             ellers knapper (anbefalet)
#   native  = tving Discords indbyggede poll
#   buttons = tving knapper med persistente Views
#POLL_MODE=auto

# Hvor mange timer en indbygget Discord-poll er åben (1-168)
#POLL_DURATION_HOURS=8

# Hvis computeren var slukket kl. 15:00: hvor mange timer efter det planlagte
# tidspunkt må botten stadig nå at sende afstemningen? 0 slår det fra.
#CATCH_UP_HOURS=6

# Hvor ofte uret tjekkes (sekunder, 5-300)
#CHECK_INTERVAL_SECONDS=20

# Skal den ugentlige afstemning rent faktisk pinge @everyone?
#PING_EVERYONE=true

# Skal /testvote også pinge @everyone? Standard er false, så du kan teste
# uden at forstyrre hele serveren. Teksten i beskeden er den samme.
#TEST_PING_EVERYONE=false

# Logniveau: DEBUG, INFO, WARNING, ERROR
#LOG_LEVEL=INFO


# === SERVER-EMOJIS (valgfrit) ==============================================
# Som standard sidder :code: paa "Efter 21:00"-linjen og :clue: paa
# "Efter 22:00"-linjen - de er allerede bygget ind i botten, saa du behoever
# IKKE at goere noget her.
#
# Linjerne herunder er kun til hvis I vil BYTTE til andre emojis. En bot kan
# IKKE bruge formen :clue: - den skal have emojiens fulde ID. Saadan finder du det:
#   1. Skriv  \:clue:  i en Discord-kanal (bemaerk backslash foran) og tryk Enter.
#   2. Discord viser den fulde form, fx  <:clue:1044354323561320539>
#   3. Kopier hele teksten - inklusive < og > - ind herunder.
#
# Er en linje forkert udfyldt, sendes afstemningen normalt bare uden den emoji.
#EMOJI_CODE=<:code:887336573933334648>
#EMOJI_CLUE=<:clue:1044354323561320539>
#EMOJI_CODEWEINER=<:codeweiner:000000000000000000>


# === TORSDAGSBAR: VOICE-REGISTRERING + STATISTIK (valgfrit) ================
# Denne funktion registrerer, hvor laenge folk sidder i voicechat under
# torsdagsbaren (torsdag 19:00 -> fredag 03:00), og laver statistik, streaks,
# rekorder og leaderboard. Slaa den til ved at udfylde de tre foerste ID'er
# herunder (eller i config.json under "torsdagsbar"). Er de ikke sat, koerer
# afstemningen bare videre uden statistik.
#
# ID'erne kopieres i Discord med Developer Mode slaaet til (hoejreklik ->
# Kopier ID). Voicekanaler: hoejreklik paa selve voicekanalen -> Kopier kanal-ID.
#
# Discord-serverens ID (samme som GUILD_ID kan ofte bruges):
#TB_SERVER_ID=indsaet_server_id_her
# Voicekanal(er) der taeller med - flere adskilles med komma:
#TB_VOICE_CHANNEL_IDS=111111111111111111,222222222222222222
# Tekstkanal hvor fredagsopsummeringen sendes:
#TB_SUMMARY_CHANNEL_ID=indsaet_tekstkanal_id_her
# Mindste deltagelse i minutter for at taelle med (standard 5):
#TB_MIN_MINUTES=5
# Optjen kun tid, mens mindst EN ANDEN person ogsaa er i baren (standard true).
# Forhindrer at man kan "farme" tid ved at sidde alene. Gaelder ogsaa bagud i
# historikken, da tiden altid genberegnes ud fra sessionerne.
#TB_REQUIRE_COMPANY=true
# Administratorrolle (navn eller ID) til admin-kommandoerne. Brugere med
# "Administrer server" har altid adgang.
#TB_ADMIN_ROLE_NAME=Torsdagsbar-admin
#TB_ADMIN_ROLE_ID=
# Antal paa leaderboardet pr. side (standard 10):
#TB_LEADERBOARD_SIZE=10
# Vis rekorder/streaks i fredagsopsummeringen? (standard true)
#TB_SUMMARY_SHOW_RECORDS=true

# --- "Du er sent paa den" ---
# Botten tagger dem, der lovede at komme i et bestemt tidsrum, men ikke er
# dukket op til tiden. "Efter 21:00", "Efter 22:00" og "Jeg kommer ikke"
# faar aldrig en forsinkelsesbesked. Hoejst en besked pr. bruger pr. aften.
#TB_LATE_ENABLED=true
# Kanal til forsinkelsesbeskeder. Udelades den, bruges opsummeringskanalen.
#TB_LATE_CHANNEL_ID=
# Hvor mange minutter efter deadline beskeden stadig maa sendes (standard 90),
# saa en bot der starter sent ikke spammer med timegamle forsinkelser.
#TB_LATE_GRACE_MINUTES=90

# --- Graenser for aftenens titler ---
# Marathonmand: mere end X timer paa en aften (standard 5)
#TB_MARATHON_HOURS=5
# Speedrun: et besoeg skal vare mindst X minutter for at taelle (standard 10)
#TB_SPEEDRUN_MIN_MINUTES=10
# Store ord: mindst X timer for sent i forhold til loeftet (standard 2)
#TB_BIG_WORDS_HOURS=2
# Waiting for players: mindst X minutter alene i baren for at taelle (standard 15)
#TB_WAITING_MIN_MINUTES=15

# --- Stemmefangst ---
# Sekunder mellem hver hentning af stemmer fra Discords indbyggede poll.
#TB_VOTE_SYNC_SECONDS=180
